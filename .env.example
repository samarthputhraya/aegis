# Copy to .env and fill in. .env is gitignored — never commit real tokens.
# Nothing here is required for `scripts/simulate_attack.py` or `tests/run_all.py`.

# --- Slack (required for the live app) ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...          # Socket Mode only (connections:write)
SLACK_SIGNING_SECRET=...          # HTTP mode only

# socket = Socket Mode (no public URL). Anything else = Flask/HTTP on $PORT.
SLACK_MODE=socket
PORT=3000

# Your own workspace's team ID. Messages from this team are treated as internal and
# are never scanned; everything else in the Connect channel is external. Getting this
# wrong is the most common reason Aegis appears to do nothing.
OUR_TEAM_ID=T_BUYER

# Key into mcp_server/data/vendors.json for the vendor on the other side.
VENDOR_KEY=acme_supplies

# --- Relationship baseline ---
# conversations = conversations.history (default; enumerates the channel)
# rts           = assistant.search.context, Slack Real-Time Search (needs search:read.public)
HISTORY_SOURCE=conversations
HISTORY_LIMIT=200

# --- Classification (optional) ---
# With neither key set, Aegis uses the offline detector in aegis/signals.py.
# ANTHROPIC_API_KEY takes precedence and uses the Messages API.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Only for a non-Anthropic endpoint: must accept {model, prompt, response_format}
# and return {"output": "<json string>"}.
LLM_API_KEY=
LLM_URL=

# --- Out-of-band verification tasks (optional) ---
# Set both to have open_verification_task file a real GitHub issue.
# Otherwise it returns a mock task.
GITHUB_TOKEN=
GITHUB_REPO=

# --- Logging ---
LOG_LEVEL=INFO
